# LLM gateway
FACTOR_FACTORY_LLM_API_KEY=your_api_key_here
FACTOR_FACTORY_LLM_BASE_URL=http://localhost:3000/v1
FACTOR_FACTORY_LLM_TIMEOUT=120
FACTOR_FACTORY_LLM_MAX_RETRIES=5

# Remote backtest / execution platform
FACTOR_FACTORY_PLATFORM_URL=http://localhost:8002

# Price-volume factory
FACTOR_FACTORY_PV_DATA_PATH=mydata/cs_wfq_data.feather
FACTOR_FACTORY_PV_VERSION=v6
FACTOR_FACTORY_PV_MACRO_ROUNDS=90
FACTOR_FACTORY_PV_INPUT_DATA=请开始你的挖掘
FACTOR_FACTORY_PV_JUDGE_MODEL=qwen3-max
FACTOR_FACTORY_PV_CODER_MODEL=qwen3-max

# Fundamental factory
FACTOR_FACTORY_FUND_DATA_PATH=mydata/fundamental_data
FACTOR_FACTORY_FUND_FIELDS_PATH=财务有效科目_大于1000.json
FACTOR_FACTORY_FUND_OUTPUT_BASE_DIR=mydata/output
FACTOR_FACTORY_FUND_BASE_INSTRUCTION=请开始挖掘高 alpha 的基本面因子
FACTOR_FACTORY_FUND_MACRO_ROUNDS=1
FACTOR_FACTORY_FUND_EVOLUTION_ROUNDS=3
FACTOR_FACTORY_FUND_ENABLE_LOCAL_FACTOR_SAVE=false
FACTOR_FACTORY_FUND_RUN_MODE=test
FACTOR_FACTORY_FUND_VERSION=v7
FACTOR_FACTORY_FUND_TEST_OUTPUT_FOLDER_NAME=fund_factory_test
FACTOR_FACTORY_FUND_JUDGE_MODEL=qwen3-max
FACTOR_FACTORY_FUND_CODER_MODEL=qwen-plus

# Fundamental single-metric factory (V8)
FACTOR_FACTORY_FUND_SINGLE_DATA_PATH=mydata/fundamental_data
FACTOR_FACTORY_FUND_SINGLE_FIELDS_PATH=财务有效科目_大于1000.json
FACTOR_FACTORY_FUND_SINGLE_GOVERNANCE_PATH=财务字段治理模板_v1.json
FACTOR_FACTORY_FUND_SINGLE_FIELD_CARDS_PATH=factor_engine/prompt_assets/factories/fundamental_single_metric/field_cards.json
FACTOR_FACTORY_FUND_SINGLE_AUTOGENERATE_FIELD_CARDS=false
FACTOR_FACTORY_FUND_SINGLE_OUTPUT_BASE_DIR=mydata/output
FACTOR_FACTORY_FUND_SINGLE_RUN_MODE=test
FACTOR_FACTORY_FUND_SINGLE_VERSION=v8
FACTOR_FACTORY_FUND_SINGLE_TEST_OUTPUT_FOLDER_NAME=fund_single_metric_test
FACTOR_FACTORY_FUND_SINGLE_TARGET_FIELDS=IS_OPERATINGREVENUE
FACTOR_FACTORY_FUND_SINGLE_MAX_TARGET_FIELDS=1
FACTOR_FACTORY_FUND_SINGLE_CONTINUE_ON_ERROR=true
FACTOR_FACTORY_FUND_SINGLE_ENABLE_LOCAL_FACTOR_SAVE=false
FACTOR_FACTORY_FUND_SINGLE_USE_HISTORY_CONTEXT=true
FACTOR_FACTORY_FUND_SINGLE_HISTORY_MAX_ROUNDS=10
FACTOR_FACTORY_FUND_SINGLE_JUDGE_MODEL=qwen-plus
FACTOR_FACTORY_FUND_SINGLE_CODER_MODEL=qwen-plus
